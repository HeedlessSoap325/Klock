<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/alarm_background"
    android:fitsSystemWindows="false">

    <!-- Small alarm indicator -->
    <ImageView
        android:id="@+id/alarmIcon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_alarm"
        android:tint="@color/alarm_secondary_text"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="72dp" />

    <!-- Large time -->
    <TextView
        android:id="@+id/alarmTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="07:30"
        android:textColor="@color/alarm_primary_text"
        android:textSize="72sp"
        android:fontFamily="sans"
        android:fontWeight="300"
        android:includeFontPadding="false"
        android:letterSpacing="-0.02"
        app:layout_constraintTop_toBottomOf="@id/alarmIcon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="28dp" />

    <!-- Alarm label -->
    <TextView
        android:id="@+id/alarmLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Wake up"
        android:textColor="@color/alarm_secondary_text"
        android:textSize="18sp"
        android:fontFamily="sans"
        android:includeFontPadding="false"
        app:layout_constraintTop_toBottomOf="@id/alarmTime"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="14dp" />

    <!-- Buttons -->
    <LinearLayout
        android:id="@+id/alarmActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingBottom="48dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Snooze -->
        <TextView
            android:id="@+id/snoozeButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/alarm_button_snooze"
            android:gravity="center"
            android:text="Snooze"
            android:textColor="@color/alarm_primary_text"
            android:textSize="18sp"
            android:fontFamily="sans"
            android:clickable="true"
            android:focusable="true"
            android:stateListAnimator="@null" />

        <!-- Dismiss -->
        <TextView
            android:id="@+id/dismissButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/alarm_button_dismiss"
            android:gravity="center"
            android:text="Dismiss"
            android:textColor="@color/alarm_dismiss_text"
            android:textSize="18sp"
            android:fontFamily="sans"
            android:clickable="true"
            android:focusable="true"
            android:stateListAnimator="@null" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>